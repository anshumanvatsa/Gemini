# PreViral Environment Variables
# Copy this to .env and fill in your values

# ── REQUIRED for Gemini AI Content Director ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: YouTube API for hashtag DB expansion ───────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Optional: Reddit API for hashtag trend data ──────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_secret
REDDIT_USER_AGENT=previral/1.0

# Get your Gemini API key at: https://aistudio.google.com/apikey
# Get your YouTube API key at: https://console.cloud.google.com/
